<Window x:Class="Akki.ImageConverter.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Akki.ImageConverter" Title="Akki Image Tools">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleArea" Margin="16,0,150,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="Assets/AppLogo.png" Width="40" Height="40" AutomationProperties.Name="Akki Image Tools logo"/><TextBlock Text="Akki Image Tools" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
  <Grid Grid.Row="1" ColumnSpacing="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="255"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition x:Name="OptionsColumn" Width="360"/></Grid.ColumnDefinitions>
   <Grid Background="{ThemeResource AkkiRailBrush}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="6" Margin="7,12"><Button Style="{StaticResource AkkiRailButton}" Background="{ThemeResource AkkiRailSelectedBrush}" Click="FocusQueue" ToolTipService.ToolTip="Image queue" AutomationProperties.Name="Image queue"><FontIcon Glyph="&#xE80F;" FontSize="18"/></Button><Button Style="{StaticResource AkkiRailButton}" Click="ShowCompactDropZone" ToolTipService.ToolTip="Open compact drop zone" AutomationProperties.Name="Open compact drop zone"><FontIcon Glyph="&#xE73F;" FontSize="18"/></Button><ToggleButton Style="{StaticResource AkkiRailToggle}" x:Name="PinButton" Click="TogglePin" ToolTipService.ToolTip="Always on top" AutomationProperties.Name="Always on top"><FontIcon Glyph="&#xE718;" FontSize="18"/></ToggleButton><Button Style="{StaticResource AkkiRailButton}" Click="ShowSettings" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button></StackPanel>
    <Button Style="{StaticResource AkkiRailButton}" Grid.Row="1" Margin="7,8" Click="ShowAbout" ToolTipService.ToolTip="About" AutomationProperties.Name="About"><Grid Width="20" Height="20"><Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/><TextBlock Text="?" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
   </Grid>
   <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0" Padding="12">
    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="Image queue" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="QueueCount" Text="0 files" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
     <StackPanel x:Name="ImportControls" Grid.Row="1" Spacing="6"><Button Click="AddImages" Content="+  Add images" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Click="AddFolder" Content="Add folder"/><Button Click="ClearQueue" Content="Clear"/></StackPanel><CheckBox x:Name="RecursiveBox" Content="Include subfolders"/><TextBlock Text="Or drop images here" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <ListView x:Name="QueueList" Grid.Row="2" SelectionMode="Single" SelectionChanged="QueueSelectionChanged" HorizontalContentAlignment="Stretch">
      <ListView.ItemTemplate><DataTemplate x:DataType="local:QueueItem">
       <Grid Padding="0,9" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="64" Height="52" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xEB9F;" FontSize="20"/><Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/></Grid></Border>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
        <Button Grid.Column="2" Click="RemoveItem" Tag="{x:Bind}" VerticalAlignment="Top" ToolTipService.ToolTip="Remove image" AutomationProperties.Name="Remove image"><FontIcon Glyph="&#xE711;" FontSize="11"/></Button>
       </Grid>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   <Grid Grid.Column="2" Padding="14" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PreviewTitle" Text="Select an image" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel x:Name="ImageNavigation" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed"><Button x:Name="PreviousImageButton" Click="PreviousImage" ToolTipService.ToolTip="Previous image" AutomationProperties.Name="Previous image"><FontIcon Glyph="&#xE76B;" FontSize="14"/></Button><TextBlock x:Name="ImagePosition" Text="1 of 2" VerticalAlignment="Center"/><Button x:Name="NextImageButton" Click="NextImage" ToolTipService.ToolTip="Next image" AutomationProperties.Name="Next image"><FontIcon Glyph="&#xE76C;" FontSize="14"/></Button></StackPanel><Button x:Name="PreviewButton" Grid.Column="2" Click="ShowPreview" Content="Refresh preview"/><Button x:Name="ToggleOptionsButton" Grid.Column="3" Click="ToggleOptions" Content="Hide options" AutomationProperties.Name="Hide options" ToolTipService.ToolTip="Hide options"/></Grid>
    <TextBlock x:Name="PreviewInfo" Grid.Row="1" Text="Add an image and select it to compare." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Grid x:Name="CompareCanvas" Grid.Row="2" SizeChanged="CompareSizeChanged" PointerPressed="ComparePointerPressed" PointerMoved="ComparePointerMoved" PointerReleased="ComparePointerReleased" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
      <TextBlock x:Name="PreviewPlaceholder" Text="Add an image to start comparing" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Image x:Name="OriginalPreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Original image preview"><Image.RenderTransform><CompositeTransform x:Name="OriginalZoomTransform"/></Image.RenderTransform></Image>
      <Grid x:Name="ConvertedClip"><Image x:Name="ConvertedPreview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Converted image preview"><Image.RenderTransform><CompositeTransform x:Name="ConvertedZoomTransform"/></Image.RenderTransform></Image></Grid>
      <Canvas x:Name="CompareDecoration" IsHitTestVisible="False" Visibility="Collapsed"><Rectangle x:Name="CompareDivider" Width="2" Fill="White"/><Border x:Name="CompareHandle" Width="36" Height="36" CornerRadius="18" Background="White"><TextBlock Text="‹  ›" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Canvas>
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4" Background="#99000000" CornerRadius="4"><TextBlock Text="Original" Foreground="White"/></Border>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8,4" Background="#99000000" CornerRadius="4"><TextBlock Text="Converted" Foreground="White"/></Border>
     </Grid>
    <StackPanel Grid.Row="3" Spacing="10"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ZoomBox" SelectionChanged="ZoomChanged" SelectedIndex="0" AutomationProperties.Name="Preview zoom" ToolTipService.ToolTip="Preview zoom"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="50%"/><ComboBoxItem Content="100%"/><ComboBoxItem Content="200%"/><ComboBoxItem Content="400%"/></ComboBox><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Click="ZoomFit" Content="Fit" ToolTipService.ToolTip="Fit image to preview" AutomationProperties.Name="Fit image to preview"/><Button Click="ZoomActual" Content="1:1" ToolTipService.ToolTip="Actual size" AutomationProperties.Name="Actual size"/></StackPanel></Grid><Grid ColumnSpacing="16" RowSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="FORMAT" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="DIMENSIONS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="2" Text="FILE SIZE" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="ResultFormat" Grid.Row="1" Text="—" FontWeight="SemiBold"/><TextBlock x:Name="ResultDimensions" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="SemiBold"/><TextBlock x:Name="ResultSize" Grid.Row="1" Grid.Column="2" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Preview result · Refresh preview after changing settings" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
     <Slider x:Name="CompareSlider" Width="1" Height="1" Opacity="0" Minimum="0" Maximum="100" Value="50" ValueChanged="CompareSliderChanged" AutomationProperties.Name="Comparison split; use arrow keys"/>
    </Grid></StackPanel>
   </Grid>
   <Grid x:Name="OptionsBorder" Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="10,10,10,0" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ToggleButton x:Name="ConvertTab" Style="{StaticResource AkkiOptionsTab}" IsChecked="True" Click="ShowConvertOptions"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8AB;" FontSize="15"/><TextBlock Text="Convert"/></StackPanel></ToggleButton>
     <ToggleButton x:Name="EditTab" Grid.Column="1" Style="{StaticResource AkkiOptionsTab}" Click="ShowEditOptions"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="15"/><TextBlock Text="Edit"/></StackPanel></ToggleButton>
     <ToggleButton x:Name="OutputTab" Grid.Column="2" Style="{StaticResource AkkiOptionsTab}" Click="ShowOutputOptions"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="15"/><TextBlock Text="Output"/></StackPanel></ToggleButton>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" Padding="14" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Save preset" Click="SavePreset"/><Button Content="Load preset" Click="LoadPreset"/></StackPanel>
      <StackPanel x:Name="ConvertOptions" Spacing="10">
      <ComboBox x:Name="FormatBox" Header="Output format" HorizontalAlignment="Stretch" SelectionChanged="FormatChanged"/>
      <CheckBox x:Name="LosslessBox" Content="Lossless compression" Checked="CompressionChanged" Unchecked="CompressionChanged"/>
      <Grid x:Name="QualityPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Slider x:Name="QualitySlider" Header="Quality" Minimum="0" Maximum="100" Value="80" StepFrequency="1" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{x:Bind QualitySlider.Value, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/></Grid>
      <NumberBox x:Name="TargetSizeBox" Header="Target size in KB (0 = off; JPEG or lossy WebP)" Minimum="0" Maximum="1000000" Value="0" SpinButtonPlacementMode="Compact"/>
      <TextBlock Text="When enabled, the app chooses quality automatically; the target may not always be achievable." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="FormatHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
      <StackPanel x:Name="EditOptions" Spacing="10" Visibility="Collapsed">
       <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7A8;" FontSize="16"/><TextBlock Text="Resize &amp; crop" FontWeight="SemiBold"/></StackPanel></Expander.Header><StackPanel Spacing="10">
      <ComboBox x:Name="CropBox" Header="Centre crop" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="No crop"/><ComboBoxItem Content="Square (1:1)"/><ComboBoxItem Content="Landscape (16:9)"/><ComboBoxItem Content="Portrait (4:5)"/></ComboBox>
      <TextBlock Text="Rotation, flips and centre crop are applied in that order before resizing, to every image in the batch." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ComboBox x:Name="ResizeBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ResizeChanged"><ComboBoxItem Content="Keep original size"/><ComboBoxItem Content="By percentage"/><ComboBoxItem Content="Fixed pixel dimensions"/></ComboBox>
      <NumberBox x:Name="PercentBox" Header="Scale (%)" Value="50" Minimum="0.1" Maximum="1000" SpinButtonPlacementMode="Compact" Visibility="Collapsed"/>
      <Grid x:Name="DimensionsPanel" Visibility="Collapsed" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><NumberBox x:Name="WidthBox" Header="Width (px)" Value="1920" Minimum="1" Maximum="32768"/><NumberBox x:Name="HeightBox" Grid.Column="1" Header="Height (px)" Value="1080" Minimum="1" Maximum="32768"/></Grid>
      <CheckBox x:Name="AspectBox" Content="Keep aspect ratio (fit within bounds)" IsChecked="True"/>
      <CheckBox x:Name="UpscaleBox" Content="Don't upscale" IsChecked="True"/>
       </StackPanel></Expander>
       <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7AD;" FontSize="16"/><TextBlock Text="Rotate &amp; flip" FontWeight="SemiBold"/></StackPanel></Expander.Header><StackPanel Spacing="10">
      <ComboBox x:Name="RotationBox" Header="Rotate clockwise" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="No rotation"/><ComboBoxItem Content="90°"/><ComboBoxItem Content="180°"/><ComboBoxItem Content="270°"/></ComboBox>
      <CheckBox x:Name="FlipHorizontalBox" Content="Flip horizontally"/>
      <CheckBox x:Name="FlipVerticalBox" Content="Flip vertically"/>
       </StackPanel></Expander>
       <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8A5;" FontSize="16"/><TextBlock Text="Watermark" FontWeight="SemiBold"/></StackPanel></Expander.Header><StackPanel Spacing="10">
      <TextBox x:Name="WatermarkTextBox" Header="Text (optional)" MaxLength="100"/>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WatermarkImageBox" Header="Image path (optional)"/><Button Grid.Column="1" Content="Browse" Click="ChooseWatermark" VerticalAlignment="Bottom"/></Grid>
      <TextBlock Text="Use either text or an image. Size is relative to the output image." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ComboBox x:Name="WatermarkPositionBox" Header="Position" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Bottom right"/><ComboBoxItem Content="Bottom left"/><ComboBoxItem Content="Top right"/><ComboBoxItem Content="Top left"/><ComboBoxItem Content="Centre"/></ComboBox>
      <NumberBox x:Name="WatermarkSizeBox" Header="Size (%)" Value="20" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact"/>
      <NumberBox x:Name="WatermarkOpacityBox" Header="Opacity (%)" Value="70" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact"/>
       </StackPanel></Expander>
      </StackPanel>
      <StackPanel x:Name="OutputOptions" Spacing="10" Visibility="Collapsed">
      <CheckBox x:Name="SourceFolderBox" Content="Save beside each original" Checked="DestinationModeChanged" Unchecked="DestinationModeChanged"/>
      <CheckBox x:Name="StructureBox" Content="Keep imported folder structure" IsChecked="True"/>
      <TextBox x:Name="FilenamePrefixBox" Header="Filename prefix (optional)"/>
      <TextBox x:Name="FilenameSuffixBox" Header="Filename suffix (optional)"/>
      <CheckBox x:Name="NumberFilesBox" Content="Add a sequence number"/>
      <TextBlock Text="Select an image and choose Compare to preview its output name." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <CheckBox x:Name="MetadataBox" Content="Remove EXIF / location metadata" IsChecked="True"/>
      <TextBox x:Name="BackgroundBox" Header="Transparency background (#RRGGBB)" Text="#FFFFFF" Visibility="Collapsed"/>
      <TextBlock Text="Existing files are renamed automatically. Originals are always kept." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <InfoBar x:Name="Notice" Grid.Row="2" Margin="12,4" IsOpen="False" IsClosable="True"/>
  <Grid Grid.Row="3" Padding="16,12" ColumnSpacing="8" RowSpacing="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Destination" VerticalAlignment="Center" FontWeight="SemiBold"/>
   <TextBox x:Name="OutputBox" Grid.Column="1" PlaceholderText="Choose a folder" VerticalAlignment="Center"/>
   <Button x:Name="OutputBrowseButton" Grid.Column="2" Click="ChooseOutput" VerticalAlignment="Center" AutomationProperties.Name="Browse output folder"><FontIcon Glyph="&#xE8B7;"/></Button>
   <Button x:Name="CancelButton" Grid.Column="3" Content="Cancel" Click="CancelConversion" Visibility="Collapsed" VerticalAlignment="Center"/>
   <Button x:Name="ConvertButton" Grid.Column="4" Click="ConvertImages" Content="Convert images" Style="{StaticResource AccentButtonStyle}" Padding="20,10" VerticalAlignment="Center" IsEnabled="False"/>
   <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="12"><TextBlock x:Name="StatusText" Text="Add images to get started" FontSize="12"/><ProgressBar x:Name="Progress" Width="160" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/><TextBlock Text="Your images stay on this PC." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  </Grid>
 </Grid>
</Window>
