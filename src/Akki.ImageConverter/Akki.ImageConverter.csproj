<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AssemblyName>Akki.ImageConverter</AssemblyName>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DistributionChannel)' == 'Store'">
    <DefineConstants>$(DefineConstants);STORE_BUILD</DefineConstants>
    <NuGetLockFilePath>packages.store.lock.json</NuGetLockFilePath>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <StoreManifestPath Condition="'$(StoreManifestPath)' == ''">$(MSBuildProjectDirectory)\..\..\packaging\store\AppxManifest.xml</StoreManifestPath>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\..\artifacts\store\single-project\</AppxPackageDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(DistributionChannel)' == 'Store'">
    <AppxManifest Include="$(StoreManifestPath)" Link="Package.appxmanifest" />
    <Content Include="..\..\packaging\store\Assets\*.png" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Velopack" Version="1.2.161" Condition="'$(DistributionChannel)' != 'Store'" />
    <ProjectReference Include="..\Akki.ImageConverter.Core\Akki.ImageConverter.Core.csproj" />
    <Content Include="Assets\App.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third-party\licenses\*" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\dependencies.md" Link="DEPENDENCIES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\third-party\sources.json" Link="licenses\sources.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The unpackaged WinUI build generates this PRI in TargetDir, but dotnet
       publish does not automatically include it. It contains App/MainWindow XBF. -->
  <Target Name="PublishAppResources" AfterTargets="ComputeFilesToPublish" Condition="'$(DistributionChannel)' != 'Store'">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The compiled WinUI resource index is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
